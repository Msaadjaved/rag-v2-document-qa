# Copy to .env and fill in. Any OpenAI-compatible endpoint works (OpenRouter, Google's OpenAI-compatible URL, ...).
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=your_model_name

# Optional: retrievers switched on by default in the UI/API (comma separated: dense,bm25,graph)
DEFAULT_RETRIEVERS=dense,bm25
